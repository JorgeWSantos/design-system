{
  "extends": "@abqm-ds/ts-config/react.json",
  "include": ["src", "vite.config.ts", "src/@types", "tsup.config.ts"],
  "exclude": [
    "**/*.stories.*",
    "**/*.test.*",
    "**/__tests__/**",
    "**/__mocks__/**",
    "src/setupTests.*"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@components/*": ["./src/components/*"],
      "@componentsSEQM/*": ["./src/componentsSEQM/*"],
      "@styles/*": ["./src/styles/*"],
      "@assets/*": ["./src/assets/*"],
      "hooks/*": ["./src/hooks/*"],
      "types/*": ["./src/types/*"],
      "utils": ["./src/utils/index"],
      "utils/*": ["./src/utils/*"]
    },
    "typeRoots": ["./node_modules/@types", "./src/@types"],
    "skipLibCheck": true
  }
}
